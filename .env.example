SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# RPC endpoints
RPC_URL=
# Optional isolation for fund indexing, NAV reporting, and observation ingestion.
# Falls back to RPC_URL when empty.
TOKENIZED_FUND_RPC_URL=
WSS_RPC_URL=

# Chain (8453 = Base mainnet, 84532 = Base Sepolia)
CHAIN_ID=8453

# Asset addresses (Base mainnet defaults).
# When CHAIN_ID=84532, override every enabled asset with its Base Sepolia
# deployment. Lazy startup rejects addresses without bytecode on the RPC chain.
WETH_ADDRESS=0x4200000000000000000000000000000000000006
WBTC_ADDRESS=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Chainlink price feed (Base mainnet ETH/USD)
CHAINLINK_ETH_USD_ADDRESS=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70

# Contract proxy addresses (set after deployment)
BATCH_SETTLER_ADDRESS=
CONTROLLER_ADDRESS=
OTOKEN_FACTORY_ADDRESS=
ORACLE_ADDRESS=
WHITELIST_ADDRESS=

# Uniswap V3 (Base mainnet)
UNISWAP_V3_ROUTER_ADDRESS=0x2626664c2603336E57B271c5C0b26F421741e481
UNISWAP_V3_QUOTER_ADDRESS=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a

# Aave V3 (Base mainnet)
AAVE_V3_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# Operator wallet (NEVER commit the real key)
OPERATOR_PRIVATE_KEY=

# Lazy CREATE2 rollout (keep eager until schema/auth/MM/frontend are deployed).
# Lazy mode fails startup unless CHAIN_ID matches RPC_URL, required addresses
# have bytecode, and Factory/BatchSettler/AddressBook/operator wiring agrees.
OTOKEN_SERIES_MODE=eager
OTOKEN_LAZY_ASSETS=eth
OTOKEN_MATERIALIZATION_LEASE_SECONDS=180
OTOKEN_MATERIALIZATION_MAX_ATTEMPTS=3
OTOKEN_ENSURE_DEADLINE_BUFFER_SECONDS=30
OTOKEN_MATERIALIZATION_DEADLINE_BUFFER_SECONDS=150
OTOKEN_ENSURE_RETRY_AFTER_MS=750
OTOKEN_MIN_TRADE_AMOUNT_RAW=1000000
OTOKEN_CAPACITY_STALE_SECONDS=120
OTOKEN_MATERIALIZATION_HOURLY_LIMIT=6
OTOKEN_MATERIALIZATION_DAILY_LIMIT=20
OTOKEN_MATERIALIZATION_SERIES_HOURLY_LIMIT=20
OTOKEN_INTENT_HMAC_SECRET=

# Privy authentication for POST /series/ensure
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
PRIVY_JWKS_URL=
PRIVY_API_URL=https://api.privy.io
PRIVY_USER_CACHE_SECONDS=60

# Tokenized fund services remain disabled until a trusted B1N-352 deployment exists.
# Contract addresses are loaded from the Supabase deployment registry, not env.
# Validate/apply it with: python -m scripts.configure_tokenized_fund
TOKENIZED_FUND_INDEXER_ENABLED=false
TOKENIZED_FUND_INDEXER_POLL_INTERVAL_SECONDS=30
FUND_NAV_REPORTER_ENABLED=false
FUND_NAV_REPORTER_PRIVATE_KEYS=
FUND_NAV_SUBMITTER_PRIVATE_KEY=
FUND_NAV_REPORTER_INTERVAL_SECONDS=300
FUND_NAV_REPORTER_TX_TIMEOUT_SECONDS=120
FUND_NAV_REPORTER_LEASE_SECONDS=180
FUND_NAV_INCLUSION_MARGIN_BLOCKS=3
FUND_NAV_EXECUTION_BUFFER_BLOCKS=15
# Base Sepolia functional testing only. Never enable on production/mainnet.
FUND_CSP_SEPOLIA_FAIR_VALUE_OBSERVATIONS_ENABLED=false
FUND_CSP_SEPOLIA_OBSERVER_PRIVATE_KEYS=
FUND_CSP_SEPOLIA_FAIR_VALUE_IV_BPS=
FUND_CSP_SEPOLIA_FAIR_VALUE_IV_SOURCE=
FUND_CSP_SEPOLIA_FAIR_VALUE_RISK_FREE_RATE_BPS=
FUND_CSP_SEPOLIA_FAIR_VALUE_SETTLEMENT_COST_BPS=
FUND_COVERED_CALL_SEPOLIA_FAIR_VALUE_OBSERVATIONS_ENABLED=false
FUND_COVERED_CALL_SEPOLIA_OBSERVER_PRIVATE_KEYS=
FUND_COVERED_CALL_SEPOLIA_FAIR_VALUE_IV_BPS=
FUND_COVERED_CALL_SEPOLIA_FAIR_VALUE_IV_SOURCE=
FUND_COVERED_CALL_SEPOLIA_FAIR_VALUE_RISK_FREE_RATE_BPS=
FUND_COVERED_CALL_SEPOLIA_FAIR_VALUE_SETTLEMENT_COST_BPS=
FUND_STATE_FRESHNESS_SECONDS=180
CONFIRMED_HEAD_FRESHNESS_SECONDS=90

# CORS allowed origins (comma-separated, use * for development only)
ALLOWED_ORIGINS=*

# Beta mode (enables /demo/settle, disables auto-settlement bot)
BETA_MODE=false
DEMO_API_KEY=
MOCK_CHAINLINK_FEED_ADDRESS=

