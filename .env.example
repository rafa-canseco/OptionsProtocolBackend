CHAINLINK_HYPE_USD_ARBITRUM_ADDRESS=0xf9ce4fE2F0EcE0362cb416844AE179a49591D567
CHAINLINK_ZEC_USD_ARBITRUM_ADDRESS=0x21082CA28570f0ccfb089465bFaEfDc77b00D367
CHAINLINK_ORACLE_MAX_AGE_SECONDS=3600
BASE_SEQUENCER_UPTIME_FEED_ADDRESS=0xBCF85224fc0756B9Fa45aA7892530B47e10b6433
ARBITRUM_RPC_URL=
ARBITRUM_CHAIN_ID=42161
ARBITRUM_SEQUENCER_UPTIME_FEED_ADDRESS=0xFdB631F5EE196F0ed6FAa767959853A9F217697D
ARBITRUM_SEQUENCER_GRACE_PERIOD_SECONDS=3600

# Contract proxy addresses (set after deployment)
BATCH_SETTLER_ADDRESS=
CONTROLLER_ADDRESS=
OTOKEN_FACTORY_ADDRESS=
ORACLE_ADDRESS=
WHITELIST_ADDRESS=
MARGIN_POOL_ADDRESS=

# Uniswap V3 (Base mainnet)
