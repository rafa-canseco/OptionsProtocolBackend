SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with `openssl rand -hex 32`; keep server-only and never reuse Supabase keys.
POSITION_CURSOR_SECRET=

# Global lifespan consumer gate (set false to keep API routes active without workers)
BACKGROUND_WORKERS_ENABLED=true

# RPC endpoints
RPC_URL=
# Optional isolation for fund indexing, NAV reporting, and observation ingestion.
# Falls back to RPC_URL when empty.
TOKENIZED_FUND_RPC_URL=
WSS_RPC_URL=

# Standalone public read-only Base RPC gateway (`uvicorn src.rpc_gateway:app`).
# Keep the Railtail URL private; only this gateway should be internet-facing.
RPC_GATEWAY_PRIMARY_URL=
RPC_GATEWAY_FALLBACK_URL=
RPC_GATEWAY_ALLOWED_ORIGINS=https://b1nary.app,https://app.b1nary.app
RPC_GATEWAY_MAX_BODY_BYTES=131072
RPC_GATEWAY_MAX_BATCH_SIZE=25
RPC_GATEWAY_MAX_UPSTREAM_RESPONSE_BYTES=2097152
RPC_GATEWAY_UPSTREAM_TIMEOUT_SECONDS=5
RPC_GATEWAY_RATE_LIMIT_PER_MINUTE=120
RPC_GATEWAY_RATE_LIMIT_BURST=60

# Chain (8453 = Base mainnet, 84532 = Base Sepolia)
CHAIN_ID=8453

# Asset addresses (Base mainnet defaults).
# When CHAIN_ID=84532, override every enabled asset with its Base Sepolia
# deployment. Lazy startup rejects addresses without bytecode on the RPC chain.
WETH_ADDRESS=0x4200000000000000000000000000000000000006
WBTC_ADDRESS=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NVDAC_ADDRESS=0xb20000000000000000000078ee7ce2fE4908108C
CBZEC_ADDRESS=0xB2000000000000000000008501b13360000cb2EC
CBHYPE_ADDRESS=0xB200000000000000000000451d033a5000cb479e
VVV_ADDRESS=0xacfE6019Ed1A7Dc6f7B508C02d1b04ec88cC21bf

# Chainlink price feeds. Foreign-chain feeds are read-only; expiry prices are
# written only to the configured Base Oracle.
CHAINLINK_ETH_USD_ADDRESS=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
CHAINLINK_BTC_USD_ADDRESS=0x07DA0E54543a844a80ABE69c8A12F22B3aA59f9D
CHAINLINK_NVDAC_USD_ADDRESS=0x04689a41629776563E6822F76f2e57D148d28513
